# Production API image: FastAPI + Scanpy + Harmony + CellTypist + NicheNet (R)
# rocker/r2u provides precompiled R binaries — avoids 60+ min source compiles on slim.
FROM rocker/r2u:noble

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    libhdf5-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip

# NicheNet R bridge — binary CRAN deps via r2u, nichenetr from GitHub
RUN install2.r --error --skipmissing remotes jsonlite dplyr \
    && R -e "remotes::install_github('saeyslab/nichenetr', upgrade='never', dependencies=TRUE)" \
    && Rscript -e 'stopifnot(requireNamespace("nichenetr", quietly=TRUE)); cat("nichenetr", as.character(packageVersion("nichenetr")), "\n")'

COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir --break-system-packages -r backend/requirements.txt greenlet>=3.1.0

COPY backend/ ./backend/
COPY pipeline/ ./pipeline/
COPY reference/ ./reference/

# Download NicheNet RDS priors (~320 MB) — CSV Zenodo paths return 404
RUN bash reference/nichenet/download_priors.sh

ENV PYTHONPATH=/app
ENV MPLBACKEND=Agg
ENV PIPELINE_DEMO_MODE=false
ENV DEVELOPMENT_ONLY=false
ENV DATA_DIR=/app/data

RUN mkdir -p /app/data/uploads /app/data/results

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "backend"]
