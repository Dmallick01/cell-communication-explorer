# Production API image: FastAPI + Scanpy + Harmony + CellTypist + NicheNet (R)
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libhdf5-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    r-base \
    r-base-dev \
    && rm -rf /var/lib/apt/lists/*

# R packages for NicheNet bridge (nichenetr from GitHub — CRAN may lag on new R versions)
RUN R -e "install.packages(c('remotes','jsonlite','dplyr'), repos='https://cloud.r-project.org')" \
    && R -e "remotes::install_github('saeyslab/nichenetr', upgrade='never')"

COPY backend/requirements.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements.txt greenlet>=3.1.0

COPY backend/ ./backend/
COPY pipeline/ ./pipeline/
COPY reference/ ./reference/

# Download NicheNet RDS priors (~320 MB) — CSV Zenodo paths return 404
RUN bash reference/nichenet/download_priors.sh

ENV PYTHONPATH=/app
ENV MPLBACKEND=Agg
ENV PIPELINE_DEMO_MODE=false
ENV DEVELOPMENT_ONLY=false
ENV DATA_DIR=/app/data

RUN mkdir -p /app/data/uploads /app/data/results

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "backend"]
